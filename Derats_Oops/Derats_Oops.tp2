END

// Interplan : parchemin particulier pxl2dw2a (absent des conversions Oops).
OUTER_SPRINT pxb_0271_res ~pxl2dw2a~
ACTION_IF FILE_EXISTS_IN_GAME ~pxl2dw2a.itm~ THEN BEGIN
  COPY_EXISTING ~pxl2dw2a.itm~ ~override~
    READ_LONG 0x6a pxb_dw2_effects
    SET pxb_dw2_spell_found = 0
    FOR (pxb_dw2_e = pxb_dw2_effects; pxb_dw2_e + 0x30 <= SOURCE_SIZE; pxb_dw2_e += 0x30) BEGIN
      READ_SHORT pxb_dw2_e pxb_dw2_opcode
      PATCH_IF (pxb_dw2_opcode = 147) BEGIN
        READ_ASCII (pxb_dw2_e + 0x14) pxb_dw2_spell (8) NULL
        SET pxb_dw2_spell_found = 1
      END
    END
  BUT_ONLY
  ACTION_IF (pxb_dw2_spell_found = 1) THEN BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%pxb_dw2_spell%.spl~ THEN BEGIN
      OUTER_SPRINT pxb_0271_res ~%pxb_dw2_spell%~
      COPY_EXISTING ~pxobase.spl~ ~override/pxob0271.spl~ WRITE_ASCIIE 0xae ~%pxb_dw2_spell%~ #8
    END
  END
END

