// @4101 - WIZARD_BARRIER

ACTION_IF (IDS_OF_SYMBOL (~spell~ ~WIZARD_BARRIER~) >= 0) THEN BEGIN
  LAF RES_NUM_OF_SPELL_NAME
    STR_VAR spell_name = ~WIZARD_BARRIER~
    RET pxomih4101_num = spell_num pxomih4101_res = spell_res
  END
  OUTER_SET pxomih4101_num -= 2000
  ACTION_IF FILE_EXISTS_IN_GAME ~%pxomih4101_res%.spl~ THEN BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~cdia%pxomih4101_num%.itm~ THEN BEGIN
      COPY_EXISTING ~%pxomih4101_res%.spl~ ~override/pxoM4101.spl~ LPF SPELL_TO_INNATE END
      
      OUTER_SPRINT pxomih4101_check ~PartyGoldGT(4999) XPGT(LastTalkedToBy,999) NumItemsPartyGT("cdia%pxomih4101_num%",0)~
    END
  END
END

