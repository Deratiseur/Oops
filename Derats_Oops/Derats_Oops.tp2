/////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////   INTERPLAN   ///////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////

ACTION_IF FILE_EXISTS_IN_GAME ~pxl2ex2a.itm~ THEN BEGIN

// Resolve each installed spell independently. Do not reinstall Interplan spells.
DEFINE_ACTION_FUNCTION PXO_INTERPLAN_SPELL
  STR_VAR direct_res = "" spell_name = ""
  RET pxi_spell_res
BEGIN
  OUTER_SPRINT pxi_spell_res ~%direct_res%~
  ACTION_IF NOT (~%spell_name%~ STRING_EQUAL ~~) THEN BEGIN
    ACTION_IF (IDS_OF_SYMBOL (~spell~ ~%spell_name%~) >= 0) THEN BEGIN
      LAF RES_NUM_OF_SPELL_NAME
        STR_VAR spell_name = EVAL ~%spell_name%~
        RET spell_res
      END
      OUTER_SPRINT pxi_spell_res ~%spell_res%~
    END
  END
END

// @1101 - Explosion de feu (niveau 1)
LAF PXO_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2ex2l~ spell_name = ~WIZARD_PX_FIRE_EXPLOSION~
  RET pxi_spell_res
END
ACTION_IF FILE_EXISTS_IN_GAME ~%pxi_spell_res%.spl~ THEN BEGIN
COPY_EXISTING ~%pxi_spell_res%.spl~ ~override/pxoIex2l.spl~ LPF SPELL_TO_INNATE END

END

// @1102 - Bouclier contre les sorts (niveau 1)
LAF PXO_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2resi~ spell_name = ~WIZARD_PX_ANTI_SPELLS_SHIELD~
  RET pxi_spell_res
END
ACTION_IF FILE_EXISTS_IN_GAME ~%pxi_spell_res%.spl~ THEN BEGIN
