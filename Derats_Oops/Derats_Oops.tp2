ACTION_IF FILE_EXISTS_IN_GAME ~MEWI967.spl~ THEN BEGIN
COPY_EXISTING ~MEWI967.spl~ ~override/pxoO6917.spl~ LPF SPELL_TO_INNATE END
COPY_EXISTING ~pxobase.spl~ ~override/pxgO6917.spl~ WRITE_ASCII 0xae ~pxoO6917~ #8
END

// @6918 - Sphere of Annihilation (level 9)
ACTION_IF FILE_EXISTS_IN_GAME ~MEWI968.spl~ THEN BEGIN
COPY_EXISTING ~MEWI968.spl~ ~override/pxoO6918.spl~ LPF SPELL_TO_INNATE END
COPY_EXISTING ~pxobase.spl~ ~override/pxgO6918.spl~ WRITE_ASCII 0xae ~pxoO6918~ #8
END
END // End du if Olvyn installé

// Dragon Summoning : sort de niveau 9.
ACTION_IF FILE_EXISTS_IN_GAME ~SUMDRAG.spl~
      AND FILE_EXISTS_IN_GAME ~SUMDRAG.itm~ THEN BEGIN
  COPY_EXISTING ~SUMDRAG.spl~ ~override/pxoD2002.spl~
    LPF SPELL_TO_INNATE END
COPY_EXISTING ~pxobase.spl~ ~override/pxgD2002.spl~ WRITE_ASCII 0xae ~pxoD2002~ #8
END

