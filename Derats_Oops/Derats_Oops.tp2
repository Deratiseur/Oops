BACKUP ~Derats_Oops/Backup~
AUTHOR ~Deratiseur, at the_deratiseur@hotmail.com~
VERSION ~5~

README ~Derats_Oops/Documents/Readme-%LANGUAGE%.html~

AUTO_TRA ~Derats_Oops/Languages/%s~ /////%s~

ALWAYS
	ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
		ACTION_DEFINE_ARRAY px_noconvert BEGIN install END
		ACTION_DEFINE_ARRAY px_reload BEGIN	pxoops END
		LAF HANDLE_CHARSETS
			INT_VAR
			infer_charset = 1
			STR_VAR
			tra_path = EVAL ~%MOD_FOLDER%/Languages~
			noconvert_array = px_noconvert
			reload_array = px_reload
		END
	END
END

LANGUAGE ~Francais~	~French~
	~Derats_Oops/Languages/French/Pxoops.tra~

LANGUAGE ~English~	~English~
	~Derats_Oops/Languages/English/Pxoops.tra~

LANGUAGE ~Simplified Chinese (by MephistoSatanDevil)~ ~SChinese~ 
	~Derats_Oops/Languages/English/Pxoops.tra~
	~Derats_Oops/Languages/SChinese/install.tra~

BEGIN @0 DESIGNATED 1 LABEL PX_Oops
REQUIRE_PREDICATE GAME_IS ~TOB BGT EET BG2EE~ @0009

DEFINE_PATCH_FUNCTION SPELL_TO_INNATE BEGIN
    WRITE_LONG 0x18 (THIS | 49152)
    WRITE_BYTE 0x1c 4

    GET_OFFSET_ARRAY headerOffsets SPL_V10_HEADERS
    PHP_EACH headerOffsets AS _ => headerOffset BEGIN
        WRITE_BYTE (headerOffset + 0x2) 4
        WRITE_SHORT (headerOffset + 0x12) 1
    END
END

EXTEND_BOTTOM ~AR3000.BCS~	~Derats_Oops/Divers/AR3000.baf~

COPY	~Derats_Oops/Divers/pxoops.cre~	~override~	SAY NAME1 @0	SAY NAME2 @0
