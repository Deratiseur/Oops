// Interplan v10 : même résolution que le composant Oops (avec ou sans SCS).
DEFINE_ACTION_FUNCTION PXB_INTERPLAN_SPELL
  STR_VAR direct_res = "" spell_name = ""
  RET pxb_interplan_res
BEGIN
  OUTER_SPRINT pxb_interplan_res ~%direct_res%~
  ACTION_IF NOT (~%spell_name%~ STRING_EQUAL ~~) THEN BEGIN
    ACTION_IF (IDS_OF_SYMBOL (~spell~ ~%spell_name%~) >= 0) THEN BEGIN
      LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = EVAL ~%spell_name%~ RET spell_res END
      OUTER_SPRINT pxb_interplan_res ~%spell_res%~
    END
  END
END

// Interplan : pxl2ex2a => pxl2ex2l
LAF PXB_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2ex2l~ spell_name = ~WIZARD_PX_FIRE_EXPLOSION~
  RET pxb_interplan_res
END
ACTION_IF FILE_EXISTS_IN_GAME ~%pxb_interplan_res%.spl~ THEN BEGIN
  OUTER_SPRINT pxb_0191_res ~%pxb_interplan_res%~
  COPY_EXISTING ~pxobase.spl~ ~override/pxob0191.spl~ WRITE_ASCIIE 0xae ~%pxb_interplan_res%~ #8
END

// Interplan : pxl2resa => pxl2resi
LAF PXB_INTERPLAN_SPELL
  STR_VAR direct_res = ~pxl2resi~ spell_name = ~WIZARD_PX_ANTI_SPELLS_SHIELD~
  RET pxb_interplan_res
END
