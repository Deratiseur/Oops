  LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_THREESTONES~ RET pxb_spell_num = spell_num pxb_spell_res = spell_res END
  ACTION_IF FILE_EXISTS_IN_GAME ~%pxb_spell_res%.spl~ THEN BEGIN
    OUTER_SET pxb_spell_num -= 2000
    ACTION_IF FILE_EXISTS_IN_GAME ~cdia%pxb_spell_num%.itm~ THEN BEGIN
      COPY_EXISTING ~pxobase.spl~ ~override/pxob0401.spl~ WRITE_ASCIIE 0xae ~%pxb_spell_res%~ #8
    END
  END
END

