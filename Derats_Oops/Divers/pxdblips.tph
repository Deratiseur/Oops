// Resolve scroll and original spell; no SPL files are created or modified.
DEFINE_ACTION_FUNCTION PXB_SCROLL
  STR_VAR id = "" scroll = "" symbol = ""
  RET pxb_check pxb_outspell pxb_outscroll pxb_outcost
BEGIN
  OUTER_SPRINT pxb_check ~False()~
  OUTER_SPRINT pxb_outspell ~spwi101~
  OUTER_SPRINT pxb_outscroll ~scrl66~
  OUTER_SET pxb_outcost = 0
  ACTION_IF NOT (~%symbol%~ STRING_EQUAL ~~) THEN BEGIN
    OUTER_SPRINT scroll ~~
    ACTION_IF (IDS_OF_SYMBOL (~spell~ ~%symbol%~) >= 0) THEN BEGIN
      LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = EVAL ~%symbol%~ RET spell_num END
      OUTER_SET spell_num -= 2000
      OUTER_SPRINT scroll ~cdia%spell_num%~
    END
  END
  ACTION_IF NOT (~%scroll%~ STRING_EQUAL ~~) THEN BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%scroll%.itm~ THEN BEGIN
      OUTER_SPRINT pxb_spell ~~
      COPY_EXISTING ~%scroll%.itm~ ~override~
        READ_LONG 0x6a pxb_effects
        FOR (pxb_e = pxb_effects; pxb_e + 0x30 <= SOURCE_SIZE; pxb_e += 0x30) BEGIN
          READ_SHORT pxb_e pxb_opcode
          PATCH_IF (pxb_opcode = 147) BEGIN
            READ_ASCII (pxb_e + 0x14) pxb_spell (8) NULL
          END
        END
      BUT_ONLY
      ACTION_IF NOT (~%pxb_spell%~ STRING_EQUAL ~~) THEN BEGIN
        ACTION_IF FILE_EXISTS_IN_GAME ~%pxb_spell%.spl~ THEN BEGIN
          COPY_EXISTING ~%pxb_spell%.spl~ ~override~
            READ_LONG 0x34 pxb_level
          BUT_ONLY
          ACTION_IF (pxb_level >= 1 AND pxb_level <= 9) THEN BEGIN
            OUTER_SET pxb_cost = 2000 * pxb_level
            OUTER_SET pxb_min = pxb_cost - 1
            OUTER_SPRINT pxb_outspell ~%pxb_spell%~
            OUTER_SPRINT pxb_outscroll ~%scroll%~
            OUTER_SET pxb_outcost = pxb_cost
            OUTER_SPRINT pxb_check ~Class(LastTalkedToBy,SORCERER) PartyGoldGT(%pxb_min%) XPGT(LastTalkedToBy,%pxb_min%) NumItemsPartyGT("%scroll%",2) NextTriggerObject(LastTalkedToBy) !HaveKnownSpellRES("%pxb_spell%")~
          END
        END
      END
    END
  END
END

LAF PXB_SCROLL STR_VAR id = ~0~ scroll = ~SCRL66~ symbol = ~~ RET pxb0_check = pxb_check pxb0_spell = pxb_outspell pxb0_scroll = pxb_outscroll pxb0_cost = pxb_outcost END
LAF PXB_SCROLL STR_VAR id = ~1~ scroll = ~SCRL67~ symbol = ~~ RET pxb1_check = pxb_check pxb1_spell = pxb_outspell pxb1_scroll = pxb_outscroll pxb1_cost = pxb_outcost END
