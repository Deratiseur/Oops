// Vanilla scroll alternatives: enumerate SCRL resources from the game's BIFF index.
// No GLOB: newly introduced mod resources in override are not enumerated.
ACTION_DEFINE_ASSOCIATIVE_ARRAY pxb_vanilla BEGIN END
COPY_EXISTING_REGEXP ~^scrl.*\.itm$~ ~override~
  READ_SHORT 0x1c pxb_item_type
  PATCH_IF pxb_item_type = 11 BEGIN
    READ_LONG 0x6a pxb_fx
    SPRINT pxb_vspell ~~
    FOR (pxb_e = pxb_fx; pxb_e + 0x30 <= SOURCE_SIZE; pxb_e += 0x30) BEGIN
      READ_SHORT pxb_e pxb_op
      PATCH_IF pxb_op = 147 BEGIN
        READ_ASCII (pxb_e + 0x14) pxb_vspell (8) NULL
      END
    END
    PATCH_IF NOT (~%pxb_vspell%~ STRING_EQUAL ~~) BEGIN
      SPRINT $pxb_vanilla(~%SOURCE_RES%~) ~%pxb_vspell%~
    END
  END
BUT_ONLY

OUTER_SPRINT pxb_vanilla_choices ~~
DEFINE_ACTION_FUNCTION PXB_VANILLA_CHOICES
  INT_VAR pxb_price = 0
  STR_VAR pxb_wanted = "" reply = ""
  RET pxb_vanilla_choices
BEGIN
  ACTION_IF pxb_price > 0 THEN BEGIN
    ACTION_CLEAR_ARRAY pxb_matches
    OUTER_SET pxb_index = 0
    ACTION_PHP_EACH pxb_vanilla AS pxb_scroll => pxb_spell BEGIN
      ACTION_IF (~%pxb_spell%~ STRING_EQUAL_CASE ~%pxb_wanted%~) THEN BEGIN
        OUTER_SET $pxb_matches(~%pxb_scroll%~) = pxb_index
        OUTER_SET pxb_index += 1
      END
    END
    OUTER_SET pxb_min = pxb_price - 1
    ACTION_PHP_EACH pxb_matches AS pxb_s1 => pxb_i1 BEGIN
      ACTION_PHP_EACH pxb_matches AS pxb_s2 => pxb_i2 BEGIN
        ACTION_IF pxb_i1 <= pxb_i2 THEN BEGIN
          ACTION_PHP_EACH pxb_matches AS pxb_s3 => pxb_i3 BEGIN
            ACTION_IF pxb_i2 <= pxb_i3 THEN BEGIN
              OUTER_SPRINT pxb_count ~~
              ACTION_IF pxb_i1 = pxb_i3 THEN BEGIN
                OUTER_SPRINT pxb_count ~NumItemsPartyGT("%pxb_s1%",2)~
              END ELSE ACTION_IF pxb_i1 = pxb_i2 THEN BEGIN
                OUTER_SPRINT pxb_count ~NumItemsPartyGT("%pxb_s1%",1) NumItemsPartyGT("%pxb_s3%",0)~
              END ELSE ACTION_IF pxb_i2 = pxb_i3 THEN BEGIN
                OUTER_SPRINT pxb_count ~NumItemsPartyGT("%pxb_s1%",0) NumItemsPartyGT("%pxb_s2%",1)~
              END ELSE BEGIN
                OUTER_SPRINT pxb_count ~NumItemsPartyGT("%pxb_s1%",0) NumItemsPartyGT("%pxb_s2%",0) NumItemsPartyGT("%pxb_s3%",0)~
              END
              OUTER_SPRINT pxb_vanilla_choices ~~~~~%pxb_vanilla_choices%
  IF ~Class(LastTalkedToBy,SORCERER) PartyGoldGT(%pxb_min%) XPGT(LastTalkedToBy,%pxb_min%) %pxb_count% NextTriggerObject(LastTalkedToBy) !HaveKnownSpellRES("%pxb_wanted%")~ THEN REPLY @%reply%
    DO ~TakePartyGold(%pxb_price%) DestroyGold(%pxb_price%)
        TakePartyItemNum("%pxb_s1%",1) DestroyItem("%pxb_s1%")
        TakePartyItemNum("%pxb_s2%",1) DestroyItem("%pxb_s2%")
        TakePartyItemNum("%pxb_s3%",1) DestroyItem("%pxb_s3%")
        AddXPObject(LastTalkedToBy,-%pxb_price%)
        ActionOverride(LastTalkedToBy,AddSpecialAbility("%pxb_wanted%"))
        CreateVisualEffectObject("SPCONTIN",LastTalkedToBy)~ GOTO Autrechose
~~~~~
            END
          END
        END
      END
    END
  END
END

LAF PXB_VANILLA_CHOICES INT_VAR pxb_price = pxb0_cost STR_VAR pxb_wanted = EVAL ~%pxb0_spell%~ reply = ~9101~ RET pxb_vanilla_choices END
